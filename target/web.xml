<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">   

	<servlet>
		<servlet-name>openAiServlet</servlet-name>
		<servlet-class>com.valerius.wealth.openfire.OpenAISessionServlet</servlet-class>
	</servlet>		

    <servlet-mapping>
        <servlet-name>openAiServlet</servlet-name>
        <url-pattern>/session</url-pattern>
    </servlet-mapping>   

	<servlet>
		<servlet-name>acsServlet</servlet-name>
		<servlet-class>com.valerius.wealth.openfire.ACSTokenServlet</servlet-class>
	</servlet>		

    <servlet-mapping>
        <servlet-name>acsServlet</servlet-name>
        <url-pattern>/acs-token</url-pattern>
    </servlet-mapping> 

	<servlet>
		<servlet-name>vodaServlet</servlet-name>
		<servlet-class>com.valerius.wealth.openfire.VodaRetrieveServlet</servlet-class>
	</servlet>		

    <servlet-mapping>
        <servlet-name>vodaServlet</servlet-name>
        <url-pattern>/voda-retrieve</url-pattern>
    </servlet-mapping> 	

<context-param><param-name>org.eclipse.jetty.ee8.jsp.precompiled</param-name><param-value>true</param-value></context-param>

<!--
Automatically created by Apache Tomcat JspC.
-->


    <servlet>
        <servlet-name>org.jivesoftware.openfire.plugin.valerius.valerius_002dconfig_jsp</servlet-name>
        <servlet-class>org.jivesoftware.openfire.plugin.valerius.valerius_002dconfig_jsp</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>org.jivesoftware.openfire.plugin.valerius.valerius_002dconfig_jsp</servlet-name>
        <url-pattern>/valerius-config.jsp</url-pattern>
    </servlet-mapping>

<!--
